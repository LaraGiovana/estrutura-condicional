    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Integer" array="False" size=""/>
            <output expression="&quot;Insira o seu numero&quot;" newline="True"/>
            <input variable="numero"/>
            <comment text="Se o seu numero for maior que 0 ele &#233; positivo e se ele for menor que 0 ele &#233; negativo"/>
            <if expression="numero &gt; 0">
                <then>
                    <output expression="&quot;o seu numero &#233; positivo&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;o seu numero n&#227;o &#233; positivo&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>

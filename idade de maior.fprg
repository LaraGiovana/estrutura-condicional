    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Uma idade deve ser insirida"/>
            <declare name="idade" type="Integer" array="False" size=""/>
            <output expression="&quot;Insira a sua idade&quot;" newline="True"/>
            <input variable="idade"/>
            <comment text="A idade deve ser maior que 18 anos para ser de maior"/>
            <if expression="idade &gt;= 18">
                <then>
                    <output expression="&quot;voc&#234; &#233; de maior&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;voc&#234; &#233; de menor&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>

    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Deve colocar um numero para descobri-lo se ele &#233; par"/>
            <declare name="numero" type="Integer" array="False" size=""/>
            <output expression="&quot;Insira o seu n&#250;mero&quot;" newline="True"/>
            <input variable="numero"/>
            <comment text="O resltado da divis&#227;o deve ser 0 para que o numero seja par"/>
            <if expression="numero % 2 == 0">
                <then>
                    <output expression="&quot;O seu numero &#233; par&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;O seu numero n&#227;o &#233; par&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
